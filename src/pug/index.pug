doctype html
html(lang='en')

    head
        meta(charset='utf-8')
        meta(name='viewport', content='width=device-width, initial-scale=1, shrink-to-fit=no')
        meta(name='description', content='Béla Páger — Materials Engineer and Data Analyst focused on manufacturing, quality and process analytics.')
        meta(name='author', content='Béla Páger')
        title Béla Páger | Materials Engineer & Data Analyst
        link(rel='icon', type='image/x-icon', href='assets/img/favicon.ico')
        script(src='https://use.fontawesome.com/releases/v5.15.4/js/all.js', crossorigin='anonymous')
        link(href='https://fonts.googleapis.com/css?family=Saira+Extra+Condensed:500,700', rel='stylesheet', type='text/css')
        link(href='https://fonts.googleapis.com/css?family=Muli:400,400i,800,800i', rel='stylesheet', type='text/css')
        link(href='css/styles.css', rel='stylesheet')

    body#page-top
        nav#sideNav.navbar.navbar-expand-lg.navbar-dark.bg-primary.fixed-top
            a.navbar-brand.js-scroll-trigger(href='#page-top')
                span.d-block.d-lg-none Béla Páger
                span.d-none.d-lg-block
                    img.img-fluid.img-profile.rounded-circle.mx-auto.mb-2(src='assets/img/profile.jpg', alt='Béla Páger')
            button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarResponsive', aria-controls='navbarResponsive', aria-expanded='false', aria-label='Toggle navigation')
                span.navbar-toggler-icon
            #navbarResponsive.collapse.navbar-collapse
                ul.navbar-nav
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#about') About
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#experience') Experience
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#education') Education
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#skills') Skills
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#projects') Projects
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#interests') Interests
                    li.nav-item
                        a.nav-link.js-scroll-trigger(href='#contact') Contact

        .container-fluid.p-0
            section#about.resume-section
                .resume-section-content
                    h1.mb-0
                        | Béla
                        span.text-primary Páger
                    .subheading.mb-5
                        | Materials Engineer · Data Analyst · Manufacturing & Quality
                    p.lead.mb-5
                        | Materials Engineer transitioning into Data Analytics, with hands-on manufacturing and quality experience. I build practical data solutions using Python, SQL, PostgreSQL, Power BI and Streamlit, with a focus on manufacturing, process capability and quality improvement.
                    .social-icons
                        a.social-icon(href='https://www.linkedin.com/in/bela-pager/', target='_blank', rel='noopener', aria-label='LinkedIn')
                            i.fab.fa-linkedin-in
                        a.social-icon(href='https://github.com/Theofil87', target='_blank', rel='noopener', aria-label='GitHub')
                            i.fab.fa-github

            hr.m-0

            section#experience.resume-section
                .resume-section-content
                    h2.mb-5 Experience
                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Plant Manager
                            .subheading.mb-3 Manufacturing / Paintshop · Iváncsa
                            p
                                | Leading paintshop operations, production processes and quality performance. Experience with powder coating, KTL, process monitoring, robotics, conveyor systems, production planning and continuous improvement.
                        .flex-shrink-0
                            span.text-primary Current

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Process Quality Engineer
                            .subheading.mb-3 Manufacturing & Quality
                            p
                                | Worked with process quality, defect analysis, root-cause investigation and production improvement, connecting engineering knowledge with data-driven problem solving.
                        .flex-shrink-0
                            span.text-primary Previous

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 Laboratory Engineer
                            .subheading.mb-3 OBO Bettermann Hungary · Bugyi
                            p
                                | Non-destructive testing laboratory work, materials characterization and laboratory measurements, including ultrasonic testing and analytical techniques.
                        .flex-shrink-0
                            span.text-primary Previous

                    .d-flex.flex-column.flex-md-row.justify-content-between
                        .flex-grow-1
                            h3.mb-0 Researcher / NDT Laboratory Engineer
                            .subheading.mb-3 Magnetec Group · University of Dunaújváros
                            p
                                | Research and development in materials and non-destructive testing, including automated ultrasound testing, scanning ultrasonic microscopy and system development.
                        .flex-shrink-0
                            span.text-primary Previous

            hr.m-0

            section#education.resume-section
                .resume-section-content
                    h2.mb-5 Education
                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0 BSc in Materials Engineering
                            .subheading.mb-3 College of Dunaújváros
                            div Specialization: Automotive Materials Technology
                        .flex-shrink-0
                            span.text-primary BSc

                    .d-flex.flex-column.flex-md-row.justify-content-between
                        .flex-grow-1
                            h3.mb-0 Building Electrician Training
                            .subheading.mb-3 Building Electrical Engineering
                            p Practical technical training completed in 2025.
                        .flex-shrink-0
                            span.text-primary 2025

            hr.m-0

            section#skills.resume-section
                .resume-section-content
                    h2.mb-5 Skills
                    .subheading.mb-3 Data & Programming
                    ul.fa-ul.mb-4
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Python · Pandas · NumPy · Matplotlib · SciPy
                        li
                            span.fa-li
                                i.fas.fa-check
                            | SQL · PostgreSQL · DBeaver
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Power BI · DAX · Excel
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Streamlit · Jupyter Notebook · Git · GitHub
                    .subheading.mb-3 Manufacturing & Quality
                    ul.fa-ul.mb-4
                        li
                            span.fa-li
                                i.fas.fa-check
                            | SPC · Cp/Cpk · Pp/Ppk · Control Charts
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Root Cause Analysis · CAPA · PFMEA · MSA
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Powder Coating · KTL · Process Quality
                        li
                            span.fa-li
                                i.fas.fa-check
                            | Robotics · PLC · SCADA · OEE
                    .subheading.mb-3 Materials & Laboratory
                    ul.fa-ul.mb-0
                        li
                            span.fa-li
                                i.fas.fa-check
                            | NDT · Ultrasonic Testing · SEM · EDX · EBSD
                        li
                            span.fa-li
                                i.fas.fa-check
                            | XRD · Hardness Testing · Tensile Testing

            hr.m-0

            section#projects.resume-section
                .resume-section-content
                    h2.mb-5 Projects
                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0
                                a(href='https://github.com/Theofil87/SPC-quality-monitoring', target='_blank', rel='noopener') SPC Quality Monitoring
                            .subheading.mb-3 Python · SQL · PostgreSQL · SPC
                            p
                                | Manufacturing-focused statistical process control project covering synthetic production data, SQL data preparation, control charts and process capability analysis.
                        .flex-shrink-0
                            span.text-primary GitHub

                    .d-flex.flex-column.flex-md-row.justify-content-between.mb-5
                        .flex-grow-1
                            h3.mb-0
                                a(href='https://github.com/Theofil87/manufacturing-production-quality-analytics', target='_blank', rel='noopener') Manufacturing Production & Quality Analytics
                            .subheading.mb-3 Python · Pandas · SQL · Power BI · Streamlit
                            p
                                | End-to-end analytics project for production volume, defects, Pareto analysis and downtime monitoring, combining data preparation with interactive dashboards.
                        .flex-shrink-0
                            span.text-primary GitHub

                    .d-flex.flex-column.flex-md-row.justify-content-between
                        .flex-grow-1
                            h3.mb-0
                                a(href='https://github.com/Theofil87/Easy_Python_projects', target='_blank', rel='noopener') Easy Python Projects
                            .subheading.mb-3 Python · Tkinter
                            p
                                | A collection of early Python projects created while learning programming fundamentals, including games, randomization and a GUI calculator.
                        .flex-shrink-0
                            span.text-primary GitHub

            hr.m-0

            section#interests.resume-section
                .resume-section-content
                    h2.mb-5 Interests
                    p
                        | I am interested in data-driven manufacturing, quality engineering, renewable energy, sustainable technology and practical automation.
                    p.mb-0
                        | My current professional direction combines engineering domain knowledge with data analytics to turn production and quality data into actionable information.

            hr.m-0

            section#contact.resume-section
                .resume-section-content
                    h2.mb-5 Contact
                    p.lead
                        | Open to opportunities in Data Analytics, Manufacturing Analytics, Quality Analytics and Process Engineering.
                    .subheading.mb-4
                        a(href='mailto:bela.pager@example.com') Contact me by email
                    .social-icons
                        a.social-icon(href='https://github.com/Theofil87', target='_blank', rel='noopener', aria-label='GitHub')
                            i.fab.fa-github
                        a.social-icon(href='https://www.linkedin.com/in/bela-pager/', target='_blank', rel='noopener', aria-label='LinkedIn')
                            i.fab.fa-linkedin-in

        script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js')
        script(src='js/scripts.js')
